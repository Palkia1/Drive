DATABASE_URL="postgresql://user:password@localhost:5432/rijklaar"
AUTH_SECRET="generate-a-random-string-for-production"

# Optional OAuth providers — leave empty to run with email/password only.
# When set, Google/Apple sign-in buttons on /inloggen and /registreren become active.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# Optional error tracking (Sentry) — leave empty to disable. The DSN is safe
# to expose client-side, so one var covers server, edge and client init.
NEXT_PUBLIC_SENTRY_DSN=""
# Only needed to upload readable source maps during build; without these the
# Sentry build plugin silently skips the upload rather than failing.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Optional product analytics (PostHog) — leave empty to disable.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# Optional transactional e-mail (Resend) — leave empty and password-reset /
# verification links are just logged to the server console instead of sent,
# so the flow still works locally without a real key.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Optional: lets the beta-tester feedback portal (/app/beta) commit a
# prompt/answers/discard edit straight back to prisma/seed.ts on GitHub, so
# it survives the next reseed instead of being silently overwritten by it.
# Leave empty and edits still apply live to the database — they just won't
# be durable across a reseed. Needs a fine-grained GitHub Personal Access
# Token scoped to ONLY this repo, with Contents: Read and write permission
# — nothing else. Treat it as a secret: it can commit to the repo.
GITHUB_SYNC_TOKEN=""
